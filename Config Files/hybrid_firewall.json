{
  "version": "1.0",
  "description": "Hybrid firewall policy (Layer 2 protections). Rules are enforced by agents on Windows/Linux using appropriate L2 tools (ebtables/nftables/WinPcap/driver-level filters).",
  "default_policy": {
    "ingress": "deny",
    "egress": "allow",
    "forward": "deny"
  },
  "global": {
    "arp_spoof_protection": true,
    "trusted_gateways": {
      "192.168.1.1": "aa:bb:cc:dd:ee:ff"
    },
    "block_promiscuous": true,
    "broadcast_rate_limit_pps": 1000,
    "on_block": {
      "method": "udp",
      "port": 33434,
      "message": "try again noob",
      "notify_backend": false
    }
  },
  "rules": [
    {
      "id": "allow_loopback",
      "enabled": true,
      "action": "allow",
      "layer": "L3",
      "direction": "both",
      "match": { "interface": "lo" },
      "description": "Allow loopback traffic",
      "priority": 200
    },
    {
      "id": "allow_established",
      "enabled": true,
      "action": "allow",
      "layer": "L3",
      "direction": "both",
      "match": { "conntrack_state": ["ESTABLISHED", "RELATED"] },
      "description": "Allow established and related connections",
      "priority": 190
    },
    {
      "id": "allow_tcp_well_known_ports",
      "enabled": true,
      "action": "allow",
      "layer": "L4",
      "direction": "ingress",
      "match": { "protocol": "tcp", "dport": [22, 80, 443] },
      "description": "Allow SSH (22), HTTP (80) and HTTPS (443)",
      "priority": 180
    },
    {
      "id": "drop_icmp_echo",
      "enabled": true,
      "action": "deny",
      "layer": "L3",
      "direction": "ingress",
      "match": { "protocol": "icmp", "icmp_type": "echo-request" },
      "description": "Drop ICMP echo requests (ping)",
      "priority": 170
    },
    {
      "id": "deny_suspicious_tcp_flags",
      "enabled": true,
      "action": "deny",
      "layer": "L4",
      "direction": "ingress",
      "match": { "protocol": "tcp", "tcp_flags": [ { "mask": "ALL", "flags": ["SYN","RST","ACK","FIN"] }, { "mask": "SYN,FIN", "flags": ["SYN","FIN"] } ] },
      "description": "Drop suspicious TCP flag combinations",
      "priority": 160
    },
    {
      "id": "deny_udp_ingress",
      "enabled": false,
      "action": "deny",
      "layer": "L4",
      "direction": "ingress",
      "match": { "protocol": "udp" },
      "description": "Deny all UDP ingress packets",
      "priority": 150
    },
    {
      "id": "rate_limit_ssh",
      "enabled": true,
      "action": "rate-limit",
      "layer": "L4",
      "direction": "ingress",
      "match": { "protocol": "tcp", "dport": 22 },
      "rate_limit": { "per_min": 25, "burst": 50 },
      "description": "Rate-limit SSH to 25/min with burst 50",
      "priority": 140
    },
    {
      "id": "rate_limit_http",
      "enabled": true,
      "action": "rate-limit",
      "layer": "L4",
      "direction": "ingress",
      "match": { "protocol": "tcp", "dport": 80 },
      "rate_limit": { "per_min": 100, "burst": 200 },
      "description": "Rate-limit HTTP to 100/min with burst 200",
      "priority": 140
    },
    {
      "id": "rate_limit_https",
      "enabled": true,
      "action": "rate-limit",
      "layer": "L4",
      "direction": "ingress",
      "match": { "protocol": "tcp", "dport": 443 },
      "rate_limit": { "per_min": 100, "burst": 200 },
      "description": "Rate-limit HTTPS to 100/min with burst 200",
      "priority": 140
    },
    {
      "id": "recent_ip_block",
      "enabled": true,
      "action": "deny",
      "layer": "L3",
      "direction": "ingress",
      "match": { "track": { "module": "recent", "name": "badip", "seconds": 600, "hitcount": 100 } },
      "on_match": { "log_prefix": "IP BLOCKED:", "log": true },
      "description": "Block IPs that hit a packet threshold inside a 10-minute window",
      "priority": 130
    },
    {
      "id": "escalate_to_mac_block",
      "enabled": true,
      "action": "escalate",
      "layer": "L2",
      "direction": "both",
      "match": { "related_log_prefix": "IP BLOCKED:" },
      "automation": {
        "steps": [
          "parse logs for 'IP BLOCKED:' to determine offender IP",
          "lookup ARP table to map IP → MAC",
          "add/enable corresponding L2 deny rule for offender MAC via ebtables/agent API"
        ],
        "notify": true
      },
      "description": "Escalate repeated IP offenders to MAC-level blocking via automation/script",
      "priority": 120
    },
    {
      "id": "auto_blocked_mac_placeholder",
      "enabled": false,
      "action": "deny",
      "layer": "L2",
      "direction": "ingress",
      "match": { "src_mac": "<dynamic>" },
      "description": "Placeholder for automated MAC blocks inserted by escalation script",
      "priority": 110
    },
    {
      "id": "log_drops_input",
      "enabled": true,
      "action": "log",
      "layer": "L3",
      "direction": "ingress",
      "match": { "on_action": "drop" },
      "log": { "prefix": "DROP: ", "level": 4, "limit_per_min": 5 },
      "description": "Log dropped ingress packets",
      "priority": 100
    },
    {
      "id": "log_drops_output",
      "enabled": true,
      "action": "log",
      "layer": "L3",
      "direction": "egress",
      "match": { "on_action": "drop" },
      "log": { "prefix": "DROP: ", "level": 4, "limit_per_min": 5 },
      "description": "Log dropped egress packets",
      "priority": 100
    },
    {
      "id": "block_null_src_mac",
      "enabled": true,
      "action": "deny",
      "layer": "L2",
      "direction": "ingress",
      "match": {
        "src_mac": "00:00:00:00:00:00"
      },
      "description": "Block frames with null/invalid source MAC",
      "priority": 100
    },
    {
      "id": "deny_unknown_multicast",
      "enabled": true,
      "action": "deny",
      "layer": "L2",
      "direction": "ingress",
      "match": {
        "dst_mac_prefix": ["01:00:5e", "33:33"]
      },
      "description": "Deny unknown IPv4/IPv6 multicast frames not matched by higher-level IGMP/MLD rules",
      "priority": 90
    },
    {
      "id": "allow_trusted_mgmt_macs",
      "enabled": true,
      "action": "allow",
      "layer": "L2",
      "direction": "ingress",
      "match": {
        "src_mac_list": ["00:11:22:33:44:55", "00:11:22:33:44:66"]
      },
      "description": "Allow management station MAC addresses",
      "priority": 80
    },
    {
      "id": "arp_guard",
      "enabled": true,
      "action": "inspect",
      "layer": "L2",
      "direction": "ingress",
      "match": {
        "ethertype": "0x0806",
        "protocol": "arp"
      },
      "inspection": {
        "mode": "validate",
        "trusted_ip_to_mac": {
          "192.168.1.1": "aa:bb:cc:dd:ee:ff"
        },
        "block_on_violation": true,
        "log_on_violation": true
      },
      "description": "ARP spoof protection: validate ARP sender IP→MAC bindings against known mapping",
      "priority": 95
    },
    {
      "id": "limit_broadcast",
      "enabled": true,
      "action": "rate-limit",
      "layer": "L2",
      "direction": "ingress",
      "match": {
        "dst_mac": "ff:ff:ff:ff:ff:ff"
      },
      "rate_limit": {
        "pps": 200,
        "burst": 500
      },
      "description": "Rate-limit broadcast frames to mitigate broadcast storms",
      "priority": 70
    },
    {
      "id": "vlan_whitelist",
      "enabled": true,
      "action": "allow",
      "layer": "L2",
      "direction": "ingress",
      "match": {
        "vlan_id_list": [10, 20, 100]
      },
      "description": "Allow frames tagged for known VLANs; untagged or other VLAN IDs fall through to default_policy",
      "priority": 60
    }
  ],
  "meta": {
    "fields": {
      "id": "string unique rule id",
      "action": "allow | deny | inspect | rate-limit | escalate | log",
      "layer": "L2 | L3 | L4",
      "direction": "ingress | egress | both",
      "match": "object: src_mac, dst_mac, dst_mac_prefix, src_mac_list, ethertype (0x####), vlan_id_list, protocol (arp|icmp|tcp|udp), dport, icmp_type, conntrack_state, interface, tcp_flags, track",
      "inspection": "object: config for deep checks like ARP validation",
      "rate_limit": "object: pps | per_min, burst",
      "track": "object: module-specific tracking config (e.g., recent: name, seconds, hitcount)",
      "automation": "object: steps and details for scripted escalation (logs → ARP lookup → add L2 block)",
      "on_match": "object: actions to take when rule matches (log_prefix, notify, etc)",
      "priority": "integer: higher runs first"
    },
    "notes": "Agents should translate these hybrid rules to platform-specific enforcement (ebtables/nftables/iptables on Linux, low-level filtering on Windows). Automation entries describe optional scripts/actions external agents should perform when a rule 'escalate' fires."
  }
}
